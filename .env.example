# OBRIGATÓRIO: use valores fortes e diferentes dos exemplos
ADMIN_PASSWORD=COLOQUE_UMA_SENHA_FORTE
SESSION_SECRET=COLOQUE_UMA_SEQUENCIA_ALEATORIA_LONGA_64_CARACTERES
# Ative TRUE em HTTPS real (proxy reverso TLS)
SECURE_COOKIES=false
# Opcional: habilita análise visual por IA no servidor
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Persistência: banco SQLite + imagens (use volume persistente em produção)
DATA_DIR=./data
